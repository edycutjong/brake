{
  "name": "brake",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "kill-test": "pnpm --filter @brake/scripts kill-test",
    "seed": "pnpm --filter @brake/scripts seed",
    "demo:hero": "pnpm --filter @brake/scripts demo:hero",
    "fork:up": "scripts/fork_up.sh",
    "g4": "pnpm --filter @brake/scripts g4",
    "demo:late": "pnpm --filter @brake/scripts demo:late",
    "demo:flood": "pnpm --filter @brake/scripts demo:flood",
    "sign:local": "pnpm --filter @brake/scripts sign:local",
    "db:migrate": "pnpm --filter @brake/scripts db:migrate",
    "bench": "python3 scripts/bench.py",
    "fmt:check": "forge fmt --check",
    "build": "pnpm --filter @brake/web build",
    "e2e": "pnpm --filter @brake/web e2e",
    "lighthouse": "pnpm --filter @brake/web lighthouse && apps/web/node_modules/.bin/lhci autorun --config=lighthouserc.landing.json",
    "audit": "pnpm audit --prod",
    "ci": "forge fmt --check && forge test && pnpm typecheck && pnpm test && pnpm build"
  }
}

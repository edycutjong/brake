# Brake — environment template. Copy to .env (never commit it) and fill in TESTNET values only.
# Every key below is read by packages/engine/src/config.ts, scripts/*.ts or script/Deploy.s.sol.

# ── Deployment selection ─────────────────────────────────────
# Which build/evidence/deploy-44005-<DEPLOYMENT>.json supplies the contract addresses: fork | live
DEPLOYMENT=fork
# Get from: https://wiki.qday.info (Aevum testnet). Default for live is https://rpc-test.qday.info; fork is anvil on :8545
# RPC_URL=https://rpc-test.qday.info
# CHAIN_ID=44005
# EXPLORER_URL=https://explorer-test.qday.info
# Public base URL of this app; on-chain evidence URIs point here (set it before a live hero run)
PUBLIC_URL=http://localhost:3000

# ── Model (the agent's reading step) ─────────────────────────
# Get from: https://console.anthropic.com → API Keys (use a separate key with a low monthly spend limit)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# anthropic (default when a key is set) | claude-cli (local dev adapter) | none (ablation: rules only).
# With no model configured the engine fails closed and HOLDS every line.
# BRAKE_MODEL=anthropic

# ── Database ─────────────────────────────────────────────────
# Get from: Vercel dashboard → Storage → Neon Postgres → pooled connection string (or a local Postgres)
DATABASE_URL=postgres://user:password@localhost:5432/brake
# DATABASE_URL_TEST=postgres://user:password@localhost:5432/brake_test

# ── Testnet wallets (Aevum 44005 — never a mainnet key) ──────
# Generate with: cast wallet new   ·   Fund at: https://faucet.qday.info/en (5 tQDAY + 1 tUSD8 per claim, 24 h cooldown)
# Deployer: deploys Brake + the ERC-8004 registries (script/Deploy.s.sol)
DEPLOYER_PRIVATE_KEY=0xyour-testnet-deployer-key
# Demo payer: signs the demo runs (labelled custodial demo mode); needs tQDAY + tUSD8
DEMO_PAYER_PRIVATE_KEY=0xyour-testnet-demo-payer-key
# Monitor agent: can only stop / hold / allow — holds no tUSD8 and no payment signature; needs tQDAY for gas
AGENT_PRIVATE_KEY=0xyour-testnet-agent-key
AGENT_ADDRESS=0xYourAgentAddress
# Keeper: submits payday batches and proof-of-stop replays; needs tQDAY for gas
KEEPER_PRIVATE_KEY=0xyour-testnet-keeper-key
# Optional: second unrelated EOA for the G1 kill test and the non-custodial sign_local run
# KILLTEST_B_PRIVATE_KEY=0xyour-testnet-second-key
# SIGN_LOCAL_PRIVATE_KEY=0xyour-own-payer-key
# Generate with: cast wallet new-mnemonic   (derives the seed vendors' payee wallets)
PAYEES_MNEMONIC="your twelve word test mnemonic goes here"

# ── App secrets ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32   (encrypts stored signatures at rest)
SIG_ENC_KEY=your-32-byte-hex
# Generate with: openssl rand -hex 32   (authenticates GET/POST /api/keeper/tick; also a GitHub Actions secret)
CRON_SECRET=your-random-secret

# ── Tuning (optional; defaults shown) ────────────────────────
# Seed invoice amounts are scaled for the faucet (1 tUSD8 per claim)
# SEED_SCALE=0.0001
# CONFIRMATIONS=3
# DAILY_SPEND_CAP_UNITS=
# DEPLOY_BLOCK=
# TX_STUCK_AFTER_S=
# AGENT_ID=
